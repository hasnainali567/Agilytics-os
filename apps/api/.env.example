# Database — Neon Postgres (Prisma 7). Two URLs, two jobs:
# - DATABASE_URL = Neon POOLER URL (host ends in -pooler, port 6543).
#   The app runtime uses this via the PrismaPg adapter in
#   src/prisma/prisma.service.ts. Get it from the Neon dashboard
#   (Connect → Pooled connection).
# - DIRECT_URL = Neon NON-pooler (direct) URL (port 5432). The Prisma
#   CLI uses this for migrations (see prisma.config.ts) — DDL must not
#   run through a pooler. Get it from Connect → Direct connection.
# Local Docker Postgres still works: point both at the same local URL.
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<dbname>?sslmode=require"
API_PORT=3001
# REQUIRED (local-dev symmetric auth): long random secret for signing
# dev-login JWTs. Generate one with: openssl rand -hex 32. Never commit
# the real value, never reuse the old "dev-only-change-me" placeholder.
# Production uses Cognito (COGNITO_USER_POOL_ID below) instead — see
# SECURITY.md §2. The API refuses to boot with neither configured.
JWT_SECRET="<generate-with-openssl-rand-hex-32>"
WEB_ORIGIN="http://localhost:5173"
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_REGION="ap-south-1"
# AI — LangChain provider (see docs/AI.md). No key = AI disabled (503).
AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=""
# OPENROUTER_API_KEY=""
# GROQ_API_KEY=""
# OPENAI_API_KEY=""
# OLLAMA_BASE_URL=http://localhost:11434
# Realtime — Phase 2 (see docs/REALTIME.md). Optional: when set, the
# realtime event bus uses Redis/Valkey pub-sub so events fan out across
# multiple API tasks. When unset, the in-memory bus is used (single task,
# local dev — no Redis required). Production: ElastiCache Serverless.
# REDIS_URL="redis://localhost:6379"
# Integrations — Phase 1 thin Slack/GitHub + Phase 2 live OAuth (see docs/INTEGRATIONS.md). Leave blank = disabled.
# SLACK_BOT_TOKEN=<redacted>
# SLACK_DEFAULT_CHANNEL=""
# SLACK_SIGNING_SECRET=<redacted>
# GITHUB_TOKEN=<redacted>
# GITHUB_WEBHOOK_SECRET=<redacted>
# --- Phase 2 live OAuth (all optional; blank = that provider disabled, authorize returns 503) ---
# Public base URL of this API — redirect URIs are built from it:
# {API_BASE}/api/v1/integrations/<PROVIDER>/callback. Must match what is
# allow-listed in each provider app. Local dev default: http://localhost:3001.
# API_BASE="http://localhost:3001"
# Token encryption at rest (AES-256-GCM placeholder until AWS KMS after
# funding). REQUIRED for tokens to survive a restart: without it the API
# generates an ephemeral in-memory key on every boot and all providers
# must be re-connected. Never commit the real value; rotate by
# re-connecting every provider. Generate one with: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=""
# Slack OAuth app (api.slack.com/apps → OAuth & Permissions → Redirect URL:
# {API_BASE}/api/v1/integrations/SLACK/callback; scopes: channels:read, chat:write, commands)
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""
# GitHub OAuth app (github.com/settings/developers → OAuth Apps → Authorization callback URL:
# {API_BASE}/api/v1/integrations/GITHUB/callback)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# Notion integration (notion.so/my-integrations → OAuth → Redirect URI:
# {API_BASE}/api/v1/integrations/NOTION/callback)
# NOTION_CLIENT_ID=""
# NOTION_CLIENT_SECRET=""
# Google OAuth client, type "Web application" (console.cloud.google.com → APIs & Services → Credentials
# → Authorized redirect URI: {API_BASE}/api/v1/integrations/GOOGLE_CALENDAR/callback,
# or set GOOGLE_REDIRECT_URI to a different allow-listed URI)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI=""
