# Local Postgres (used by apps/api). Copy to .env and fill in real values for AWS.
DATABASE_URL="postgresql://agilytics:agilytics@localhost:5432/agilytics?schema=public"
# API
API_PORT=3001
JWT_SECRET="dev-only-change-me"
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_REGION="ap-south-1"
# Web (Vite — VITE_ vars are exposed to the browser)
VITE_API_URL="http://localhost:3001/api/v1"
# AI — LangChain provider (see docs/AI.md). No key = AI disabled (503).
AI_PROVIDER=gemini
# Worker — overdue sweep scheduler (see docs/INTEGRATIONS.md § Automations).
# SWEEP_API_TOKEN is a JWT for a service user with AUTOMATIONS_MANAGE in
# the tenant to sweep; without it the scheduler stays off (auth gap noted
# in apps/worker/src/jobs/sweep-scheduler.service.ts). Production uses
# SQS/EventBridge instead of this interval.
# SWEEP_API_BASE_URL=http://localhost:3001
# SWEEP_INTERVAL_MS=900000
# SWEEP_ENABLED=true
# SWEEP_API_TOKEN=<redacted>
# AI_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=""
# OPENROUTER_API_KEY=""
# GROQ_API_KEY=""
# OPENAI_API_KEY=""
# OLLAMA_BASE_URL=http://localhost:11434
