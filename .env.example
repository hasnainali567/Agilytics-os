# Local Postgres (used by apps/api). Copy to .env and fill in real values for AWS.
DATABASE_URL="postgresql://agilytics:agilytics@localhost:5432/agilytics?schema=public"
# API
API_PORT=3001
JWT_SECRET="dev-only-change-me"
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_REGION="ap-south-1"
# Web (Vite — VITE_ vars are exposed to the browser)
VITE_API_URL="http://localhost:3001/api/v1"
# AI — LangChain provider (see docs/AI.md). No key = AI disabled (503).
AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=""
# OPENROUTER_API_KEY=""
# GROQ_API_KEY=""
# OPENAI_API_KEY=""
# OLLAMA_BASE_URL=http://localhost:11434
